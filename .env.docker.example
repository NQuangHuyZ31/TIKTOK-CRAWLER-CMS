# ==============================================================================
# Docker Compose Environment Configuration
# ==============================================================================

# Application Exposure Ports
CMS_PORT=8000
CRAWLER_PORT=8001
DB_PORT=3306

# MySQL Database Configuration
DB_DATABASE=tiktok_crawler
DB_USERNAME=tiktok_user
DB_PASSWORD=secret_password
DB_ROOT_PASSWORD=root_password

# CMS Application Settings
APP_NAME="CMS TikTok Crawler"
APP_ENV=production
APP_KEY=base64:GkS35gLq8gM+9UvH2lA5jD1vE4kF7mO0pQ2rS4tU6w8=
APP_DEBUG=false
APP_URL=http://localhost:8000
FORCE_HTTPS=false
RUN_MIGRATIONS=true
RUN_SEEDER=false

# Inter-service Connectivity
CRAWLER_SERVICE_URL=http://crawler-service:8001
BACKEND_CALLBACK_URL=http://cms-app/admin/api/public/crawler
CRAWLER_AUTH_TOKEN=
LARAVEL_API_SECRET=
