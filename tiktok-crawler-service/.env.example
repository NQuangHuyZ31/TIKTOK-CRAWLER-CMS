# ==============================================================================
# HƯỚNG DẪN KHỞI ĐỘNG DỊCH VỤ CRAWLER (STARTUP COMMANDS)
# ==============================================================================
# Cách 1 (Khuyên dùng từ thư mục tiktok-crawler-service):
#   python -m uvicorn app.api.routes:app --host 0.0.0.0 --port 8001
# Cách 2 (Chạy script main.py từ thư mục tiktok-crawler-service):
#   python app/main.py
# Cách 3 (Chạy script main.py trực tiếp từ bên trong thư mục app):
#   cd app
#   python main.py
#
# LỆNH KIỂM TRA TRẠNG THÁI THỜI GIAN THỰC (STATUS DASHBOARD):
#   python scripts/status.py              # Xem trạng thái tức thời
#   python scripts/status.py --watch      # Tự động cập nhật liên tục mỗi 2 giây
# ==============================================================================

# ==============================================================================
# 1. SERVER & NETWORK BINDING
# ==============================================================================
# Địa chỉ IP lắng nghe (0.0.0.0 lắng nghe trên mọi card mạng/container)
CRAWLER_HOST=0.0.0.0

# Cổng dịch vụ FastAPI (tránh xung đột port 8000 của Laravel CMS)
CRAWLER_PORT=8001

# Số lượng Profile Worker chạy song song xử lý tài khoản
# [Khuyên dùng: 5 - 10 cho 1 IP đơn; 20 - 25 nếu chạy qua Proxy Pool xoay vòng IP]
WORKER_COUNT=10

# Đường dẫn tệp SQLite WAL lưu trữ hàng đợi công việc và checkpoint
QUEUE_DB_PATH=data/queue.db

# Thư mục lưu trữ các tệp danh sách hạt giống (seed datasets CSV/TXT)
DATASETS_DIR=datasets


# ==============================================================================
# 2. LARAVEL CMS INTEGRATION & SECURITY AUTH
# ==============================================================================
# URL gốc của Laravel CMS
LARAVEL_BASE_URL=http://127.0.0.1:8000

# Endpoint API tiếp nhận callback webhook và trạng thái job từ Crawler
LARAVEL_API_URL=http://127.0.0.1:8000/admin/api/public/crawler

# Token bảo mật xác thực nội bộ (phải khớp chính xác với CRAWLER_SERVICE_TOKEN bên Laravel CMS)
CRAWLER_TOKEN=your_shared_crawler_secret_token

# Khóa bí mật dùng để ký chữ ký điện tử HMAC-SHA256 trên webhook payload (mặc định lấy CRAWLER_TOKEN nếu để trống)
CRAWLER_HMAC_SECRET=your_shared_crawler_secret_token

# Định danh phiên bản khóa HMAC (hỗ trợ xoay vòng khóa không gián đoạn)
CRAWLER_KEY_ID=key_v1

# Số lượng sự kiện tối đa gom vào 1 lô (batch) webhook gửi sang Laravel
# [Khuyên dùng: 20 - 50 (mặc định 25 giúp cân bằng giữa throughput và độ trễ)]
OUTBOX_BATCH_SIZE=25

# Thời gian chờ tối đa (giây) khi gửi 1 lô webhook sang Laravel trước khi timeout
# [Khuyên dùng: 5.0 giây]
OUTBOX_DISPATCH_TIMEOUT=5.0


# ==============================================================================
# 3. JOB SCHEDULER & CONCURRENCY CONTROL
# ==============================================================================
# Số Job cào tối đa được phép chạy đồng thời trên toàn máy chủ
# [Khuyên dùng: 10 - 20 jobs]
CRAWLER_MAX_ACTIVE_JOBS=10

# Số Job tối đa một user/owner được phép chạy đồng thời (chống độc chiếm tài nguyên)
# [Khuyên dùng: 2 - 3 jobs/user]
CRAWLER_MAX_ACTIVE_JOBS_PER_OWNER=3

# Số lượng tài khoản mục tiêu được đóng gói vào 1 Chunk công việc
# [Khuyên dùng: 25 - 50 accounts/chunk]
CRAWLER_CHUNK_SIZE=25

# Thời hạn giữ quyền Chunk của Worker trước khi bị thu hồi tự động nếu worker treo (ms)
# [Khuyên dùng: 60000 ms (1 phút)]
CRAWLER_CHUNK_LEASE_MS=60000

# Số lần tối đa cho phép Chunk bị crash bất thường trước khi đánh dấu lỗi hẳn
# [Khuyên dùng: 3 lần]
CRAWLER_MAX_CHUNK_CRASHES=3

# Số lần thử lại tối đa cho mỗi tài khoản mục tiêu trước khi chuyển thành lỗi vĩnh viễn
# [Khuyên dùng: 3 lần]
CRAWLER_MAX_TARGET_ATTEMPTS=3

# Trần tốc độ cào tối đa dùng chung toàn máy chủ (Requests Per Second) để giữ IP an toàn
# [Khuyên dùng: 1.5 - 2.0 req/s cho 1 IP công khai]
CRAWLER_GLOBAL_RATE_LIMIT_RPS=2.0


# ==============================================================================
# 4. TIMEOUTS & RETRY LIMITS
# ==============================================================================
# Thời gian chờ tối đa (giây) cho mỗi HTTP request khi kết nối đến TikTok
# [Khuyên dùng: 15 - 20 giây]
REQUEST_TIMEOUT=20

# Thời gian tối đa (giây) cho phép hoàn thành thu thập dữ liệu của một tài khoản
# [Khuyên dùng: 60 - 90 giây]
ACCOUNT_TIMEOUT=90

# Số lần thử lại tối đa cho mỗi mục tiêu cào khi gặp lỗi mạng tạm thời
# [Khuyên dùng: 3 lần]
MAX_RETRIES=3

# Số lần tối đa cho phép khôi phục lại công việc sau sự cố dừng đột ngột (service crash)
# [Khuyên dùng: 3 lần]
MAX_JOB_RESUMES=3

# Thời gian chờ (giây) trước khi đưa job trở lại hàng đợi nếu Laravel CMS tạm thời không phản hồi
# [Khuyên dùng: 30 - 60 giây]
REQUEUE_DELAY_SECONDS=60


# ==============================================================================
# 5. ANTI-BAN RATE LIMITING & CIRCUIT BREAKER (CHỐNG CHẶN IP TIKTOK)
# ==============================================================================
# Tốc độ gọi cơ sở (Requests Per Second) tới TikTok để tránh bị gắn cờ bot
# [Khuyên dùng: 1.0 - 1.5 req/s (khoảng cách an toàn ~0.67s)]
RATE_LIMIT_PER_SEC=1.5

# Độ trễ ngẫu nhiên tối thiểu (giây) cộng thêm giữa hai yêu cầu liên tiếp
# [Khuyên dùng: 0.5 - 0.8 giây]
REQUEST_DELAY_MIN=0.6

# Độ trễ ngẫu nhiên tối đa (giây) cộng thêm giữa hai yêu cầu để tạo hành vi như người thật
# [Khuyên dùng: 1.2 - 1.8 giây]
REQUEST_DELAY_MAX=1.5

# Số lần liên tiếp gặp lỗi WAF/Challenge thật trước khi ngắt mạch toàn bộ worker
# [Khuyên dùng: 8 - 10 lần]
CIRCUIT_BREAKER_THRESHOLD=10

# Thời gian đóng băng toàn bộ Worker (giây) khi ngắt mạch để IP được hạ nhiệt
# [Khuyên dùng: 15 - 30 giây]
CIRCUIT_BREAKER_COOLDOWN=15


# ==============================================================================
# 6. RESOURCE & DATA BOUNDS
# ==============================================================================
# Số tài khoản tối đa được tiếp nhận trong một Job (tránh payload quá lớn)
# [Khuyên dùng: 1000 - 2000 accounts/job]
MAX_ACCOUNTS_PER_JOB=2000

# Dung lượng hàng đợi công việc tối đa được phép lưu trong SQLite
# [Khuyên dùng: 5000 jobs]
QUEUE_MAX_SIZE=5000

# Dung lượng tối đa (bytes) của file ảnh đại diện avatar tải về
# [Khuyên dùng: 2097152 (2MB)]
AVATAR_MAX_BYTES=2097152

# Dung lượng tối đa (bytes) của phản hồi HTML từ TikTok (chống tràn RAM)
# [Khuyên dùng: 5242880 (5MB)]
MAX_HTML_BYTES=5242880

# User-Agent trình duyệt Desktop mặc định (bắt buộc dùng Desktop để TikTok trả về đầy đủ JSON SSR)
# [Khuyên dùng: Desktop Chrome hiện đại]
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36


# ==============================================================================
# 7. DISCOVERY REFILL WORKER & CANDIDATE POOL
# ==============================================================================
# Kích hoạt tiến trình Discovery tự động khám phá ứng viên mới vào kho
CRAWLER_DISCOVERY_ENABLED=true

# Số lượng tiến trình Discovery Worker chạy ngầm song song
# [Khuyên dùng: 2 - 3 workers (tiết kiệm tài nguyên mạng cho Profile Worker)]
DISCOVERY_WORKER_COUNT=3

# Thời gian nghỉ (giây) giữa các chu kỳ kiểm tra kho ứng viên
# [Khuyên dùng: 10.0 giây]
DISCOVERY_INTERVAL_SECONDS=10.0

# Dung lượng kho ứng viên mục tiêu cần duy trì sẵn sàng (Target Size)
CRAWLER_CANDIDATE_POOL_TARGET_SIZE=5000

# Ngưỡng tối thiểu của kho ứng viên để tự động kích hoạt nạp thêm từ Frontier (Low Watermark)
# [Khuyên dùng: 500 - 1000 accounts]
CRAWLER_CANDIDATE_POOL_LOW_WATERMARK=1000

# Số lượng video tối đa quét từ mỗi tài khoản hạt giống để trích xuất ứng viên mới
# [Khuyên dùng: 15 - 20 videos/seed]
CRAWLER_DISCOVERY_SCAN_VIDEOS_PER_SEED=20

# Cho phép tự động fallback sang dataset.csv nếu discovery frontier đang rỗng
ALLOW_BOOTSTRAP_FALLBACK=true

# Bật/Tắt giới hạn tốc độ khi nạp ứng viên từ Frontier vào Candidate Pool nội bộ
# false = Nạp tức thì (Instant, 0.005s/mẻ 50 acc, tối ưu hiệu năng)
# true  = Bật độ trễ 2.5s/acc
# [Khuyên dùng: false]
DISCOVERY_RATE_LIMITED=false

# Số lượng ứng viên tối đa nạp vào kho trong 1 chu kỳ batch
# [Khuyên dùng: 50 - 100 accounts/batch]
DISCOVERY_MAX_BATCH_SIZE=50

# Ngưỡng ứng viên chờ trong Frontier để kích hoạt cào thêm hạt giống
# [Khuyên dùng: 100 accounts]
DISCOVERY_FRONTIER_THRESHOLD=100

# Tỷ lệ điều tiết tài nguyên giữa Profile Worker và Discovery Worker (Profile : Discovery)
# [Khuyên dùng: 4 (4 lượt Profile thì có 1 lượt Discovery)]
SHARED_RATE_LIMIT_PROFILE_WEIGHT=4


# ==============================================================================
# 8. SAFEGUARDS & DISK STORAGE
# ==============================================================================
# Dung lượng đĩa trống tối thiểu (GB) trước khi tạm dừng nhận Job mới (Chống tràn ổ cứng)
# [Khuyên dùng: 5.0 GB]
CRAWLER_MIN_FREE_DISK_GB=5.0

# Dung lượng file SQLite WAL tối đa (bytes) trước khi cưỡng chế chạy WAL checkpoint
# [Khuyên dùng: 524288000 - 1048576000 (500MB - 1GB)]
CRAWLER_MAX_WAL_BYTES=1048576000
