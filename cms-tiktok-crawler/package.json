{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "cms-tiktok-crawler",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"watch": "vite build --watch",
		"dev": "vite",
		"mix": "node scripts/mix-module.cjs all",
		"mix:all": "node scripts/mix-module.cjs all",
		"mix:watch": "mix watch",
		"mix:prod": "node scripts/mix-module.cjs all --prod",
		"mix:core": "node scripts/mix-module.cjs Core",
		"mix:crawler": "node scripts/mix-module.cjs Crawler",
		"mix:tiktokaccount": "node scripts/mix-module.cjs TiktokAccount",
		"mix:system": "node scripts/mix-module.cjs System",
		"mix:role": "node scripts/mix-module.cjs Role",
		"mix:permission": "node scripts/mix-module.cjs Permission",
		"mix:auth": "node scripts/mix-module.cjs Auth",
		"mix:user": "node scripts/mix-module.cjs User",
		"mix:guideline": "node scripts/mix-module.cjs Guideline",
		"mix:module": "node scripts/mix-module.cjs",
		"check-types": "node ./node_modules/typescript/bin/tsc --noEmit"
	},
	"overrides": {
		"webpack": "5.94.0"
	},
	"devDependencies": {
		"@babel/preset-react": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"dayjs": "^1.11.13",
		"laravel-mix": "^6.0.49",
		"laravel-vite-plugin": "^3.1",
		"postcss": "^8.5.31",
		"tailwindcss": "^4.0.0",
		"ts-loader": "^9.6.2",
		"typescript": "^7.0.2",
		"vite": "^8.0.0",
		"webpack": "5.94.0"
	},
	"optionalDependencies": {
		"@laravel/multiplex": "^0.4.1"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.13.0",
		"antd": "^6.6.5",
		"axios": "^1.20.0",
		"react": "^19.3.0",
