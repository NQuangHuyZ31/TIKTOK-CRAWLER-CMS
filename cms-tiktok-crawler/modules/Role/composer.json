{
	"name": "cms-tiktok-crawler/module-role",
	"description": "Role management module for Tiktok CMS",
	"version": "1.0.0",
	"type": "library",
	"require": {
		"php": "^8.3",
		"laravel/framework": "^13.17",
		"cms-tiktok-crawler/module-core": "1.0.0",
		"cms-tiktok-crawler/module-permission": "1.0.0"
	},
	"autoload": {
		"psr-4": {
			"Modules\\Role\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Modules\\Role\\Providers\\RoleServiceProvider"
			]
		}
	},
	"minimum-stability": "stable"
}
