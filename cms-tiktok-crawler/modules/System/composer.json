{
	"name": "cms-tiktok-crawler/module-system",
	"description": "System configuration, roles, and permissions module for Tiktok CMS",
	"version": "1.0.0",
	"type": "library",
	"require": {
		"php": "^8.3",
		"laravel/framework": "^13.17",
		"cms-tiktok-crawler/module-core": "1.0.0"
	},
	"autoload": {
		"psr-4": {
			"Modules\\System\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Modules\\System\\Providers\\SystemServiceProvider"
			]
		}
	},
	"minimum-stability": "stable"
}
