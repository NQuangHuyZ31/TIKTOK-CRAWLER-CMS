{
	"name": "cms-tiktok-crawler/module-crawler",
	"description": "Crawler module for Tiktok CMS",
	"version": "1.0.0",
	"type": "library",
	"require": {
		"php": "^8.3",
		"laravel/framework": "^13.17",
		"cms-tiktok-crawler/module-core": "1.0.0"
	},
	"autoload": {
		"psr-4": {
			"Modules\\Crawler\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Modules\\Crawler\\Providers\\CrawlerServiceProvider"
			]
		}
	},
	"minimum-stability": "dev"
}
